---
import { contacto } from '../data/site';
import { contacto as texto } from '../data/contenido';
import IconoWhatsApp from './IconoWhatsApp.astro';
import FormularioContacto from './FormularioContacto.astro';

// WhatsApp va primero y destacado: es el canal principal. El formulario es
// la segunda vía y se abre en una ventana (FormularioContacto.astro). El
// correo es respaldo: una línea bajo las tarjetas, no una tarjeta más.
---

<section class="seccion seccion--contacto" id="contacto">
  <div class="contenedor contacto">
    <div class="contacto__intro">
      <h2 class="contacto__titulo">
        {texto.titulo.antes}<span class="enfasis">{texto.titulo.enfasis}</span>{texto.titulo.despues}
      </h2>

      <p class="contacto__bajada">{texto.bajada}</p>
    </div>

    <div class="contacto__grilla">
      <a class="canal canal--principal" href={contacto.whatsappCL.url}>
        <span class="canal__etiqueta">{texto.etiquetaWhatsApp}</span>
        <span class="canal__valor">{contacto.whatsappCL.numero}</span>
        <IconoWhatsApp tamano={20} color="var(--accent)" />
      </a>

      <!-- Sin JavaScript la ventana no abre: la tarjeta se oculta (ver el
           estilo de abajo) y quedan WhatsApp y el correo. -->
      <button class="canal canal--formulario" type="button" data-abrir-formulario aria-haspopup="dialog">
        <span class="canal__etiqueta">{texto.etiquetaFormulario}</span>
        <span class="canal__valor">{texto.formulario.abrir}</span>
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
          <path d="M3 9h11M10 5l4 4-4 4" stroke="var(--accent)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
        </svg>
      </button>

      <p class="contacto__correo">
        {texto.correo.antes}
        <a class="boton boton--secundario boton--chico" href={`mailto:${contacto.email}`}>{contacto.email}</a>
      </p>
    </div>

    <FormularioContacto />
  </div>
</section>

<style>
  /* La página cierra como abre: la misma retícula del hero, desvanecida
     hacia los bordes, y una luz ámbar detrás de las tarjetas. */
  .seccion--contacto {
    position: relative;
    isolation: isolate;
  }

  .seccion--contacto::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image:
      linear-gradient(var(--reticula) 1px, transparent 1px),
      linear-gradient(90deg, var(--reticula) 1px, transparent 1px);
    background-size: 64px 64px;
    -webkit-mask-image: radial-gradient(ellipse 70% 70% at 60% 50%, #000 30%, transparent 100%);
    mask-image: radial-gradient(ellipse 70% 70% at 60% 50%, #000 30%, transparent 100%);
  }

  .seccion--contacto::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    background: radial-gradient(40% 55% at 72% 50%, rgba(250, 204, 21, 0.11), transparent 70%);
  }

  /* Teléfono: título, bajada, las dos tarjetas y el correo debajo, en una sola
     columna. Desde 900px, dos columnas: título y bajada a la izquierda; las
     tarjetas y el correo apilados a la derecha. */
  .contacto {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem;
  }

  .contacto__intro {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contacto__titulo {
    max-width: 32rem;
    font-size: var(--size-2xl-fluid);
    font-weight: var(--weight-light);
    line-height: 1.04;
    letter-spacing: -0.03em;
    text-wrap: pretty;
  }

  .contacto__bajada {
    max-width: 36rem;
    font-size: var(--size-md);
    line-height: 1.58;
    color: var(--text-body);
  }

  .contacto__grilla {
    display: grid;
    gap: 0.75rem;
  }

  .canal {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    min-height: var(--tap);
    padding: 1.125rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
  }

  .canal:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .canal--principal {
    background: var(--surface-accent);
    border-color: var(--border-accent);
  }

  /* El correo, a la vista para quien lo quiera copiar, en un botón chico:
     respaldo, no una tarjeta más. */
  .contacto__correo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-top: 0.25rem;
    font-size: var(--size-base);
    color: var(--text-soft);
  }

  .contacto__correo a {
    overflow-wrap: anywhere;
  }

  /* La tarjeta del formulario es un <button>: se le quita lo del sistema
     para que se vea igual a las otras dos. */
  .canal--formulario {
    width: 100%;
    font-family: inherit;
    text-align: left;
    cursor: pointer;
  }

  :global(html:not(.js)) .canal--formulario {
    display: none;
  }

  .canal :global(svg),
  .canal--formulario svg {
    position: absolute;
    top: 1.125rem;
    right: 1.25rem;
  }

  .canal__etiqueta {
    font-size: var(--size-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-soft);
  }

  .canal__valor {
    font-size: 1.25rem;
    font-weight: var(--weight-medium);
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }

  @media (min-width: 768px) {
    .contacto__grilla {
      gap: 1rem;
    }

    .canal {
      padding: 1.5rem 1.5rem;
    }

    .canal :global(svg),
    .canal--formulario svg {
      top: 1.5rem;
      right: 1.5rem;
    }
  }

  @media (min-width: 900px) {
    .contacto {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
      column-gap: 3rem;
    }
  }
</style>
