---
import { herramientas } from '../../data/portafolio';

// Herramientas agrupadas por área, sin niveles, y los idiomas aparte con su
// nivel (ese sí es un dato que una empresa pregunta). Cada grupo lleva un
// tono distinto en su marca, los mismos del resto del sitio.

const tonos = ['var(--tono-turquesa)', 'var(--tono-naranjo)', 'var(--tono-violeta)', 'var(--accent)'];
---

<section class="seccion seccion--banda" id="herramientas">
  <div class="contenedor herramientas">
    <div class="herramientas__encabezado">
      <p class="rotulo rotulo--seccion">{herramientas.rotulo}</p>
      <h2 class="titulo-seccion">
        {herramientas.titulo.antes}<span class="enfasis">{herramientas.titulo.enfasis}</span>{herramientas.titulo.despues}
      </h2>
    </div>

    <div class="herramientas__grilla">
      {
        herramientas.grupos.map((grupo, i) => (
          <div class="grupo" style={`--tono: ${tonos[i % tonos.length]}`} data-revelar>
            <h3 class="grupo__nombre">{grupo.nombre}</h3>
            <ul class="grupo__items">
              {grupo.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="grupo grupo--idiomas" data-revelar>
        <h3 class="grupo__nombre">{herramientas.idiomas.nombre}</h3>
        <dl class="idiomas">
          {
            herramientas.idiomas.items.map((it) => (
              <div class="idiomas__fila">
                <dt>{it.idioma}</dt>
                <dd>{it.nivel}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .herramientas {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .herramientas__encabezado {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .herramientas__grilla {
    display: grid;
    gap: 1rem;
  }

  .grupo {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    background:
      radial-gradient(80% 70% at 0% 0%, color-mix(in srgb, var(--tono, var(--text-soft)) 10%, transparent), transparent 70%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.02)),
      var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  /* Línea de color arriba, como las tarjetas de Consultoría. */
  .grupo::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(to right, var(--tono, var(--border-strong)), transparent 85%);
  }

  .grupo__nombre {
    font-family: var(--font-mono);
    font-size: var(--size-xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--tono, var(--text-soft));
  }

  .grupo__items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grupo__items li {
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.04);
    font-size: var(--size-sm);
    color: var(--text);
  }

  .idiomas {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .idiomas__fila {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.5rem;
  }

  .idiomas__fila + .idiomas__fila {
    border-top: 1px solid var(--border);
  }

  .idiomas dt {
    font-size: var(--size-base);
    color: var(--text);
  }

  .idiomas dd {
    margin: 0;
    font-size: var(--size-sm);
    color: var(--text-soft);
  }

  /* Desde 768px, Idiomas ocupa dos columnas y muestra sus tres idiomas en
     fila: así la grilla de cinco tarjetas no deja un hueco al final. */
  @media (min-width: 768px) {
    .herramientas__grilla {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .grupo--idiomas {
      grid-column: span 2;
    }

    .idiomas {
      flex-direction: row;
    }

    .idiomas__fila {
      flex: 1;
      flex-direction: column;
      gap: 0.25rem;
      padding: 0 1.25rem;
    }

    .idiomas__fila:first-child {
      padding-left: 0;
    }

    .idiomas__fila + .idiomas__fila {
      border-top: 0;
      border-left: 1px solid var(--border);
    }
  }

  @media (min-width: 1100px) {
    .herramientas__grilla {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
