---
import { Image } from 'astro:assets';
import { proyectos } from '../../data/portafolio';

// Los proyectos como tres tarjetas en fila: una captura, qué es, el rol, las
// herramientas y el enlace. Lo que hice va plegado: quien evalúa recorre las
// tres de un vistazo y abre lo que le interesa. Antes cada proyecto ocupaba
// una pantalla entera con su galería al lado.
//
// Las capturas se ven en grande en una ventana (<dialog>) que se abre al tocar
// la imagen de la tarjeta, con flechas y miniaturas para recorrerlas. Sin
// JavaScript queda la primera captura en la tarjeta y nada más.
//
// El color de marca de cada proyecto pinta la línea de arriba de la tarjeta,
// el borde de la miniatura activa y los puntos de la lista.
//
// La captura va en un marco de ventana, con su dominio y "En línea", como en
// la franja de trabajos del inicio: el mismo objeto en las dos páginas.

const tamanosTarjeta = '(min-width: 1080px) 340px, (min-width: 720px) 45vw, calc(100vw - 40px)';
const tamanosVentana = '(min-width: 1120px) 1040px, calc(100vw - 2rem)';
---

<section class="seccion" id="proyectos">
  <div class="contenedor proyectos">
    <div class="proyectos__encabezado">
      <p class="rotulo rotulo--seccion">{proyectos.rotulo}</p>
      <h2 class="titulo-seccion">
        {proyectos.titulo.antes}<span class="enfasis">{proyectos.titulo.enfasis}</span>{proyectos.titulo.despues}
      </h2>
      <p class="proyectos__bajada">{proyectos.bajada}</p>
    </div>

    <div class="proyectos__grilla">
      {
        proyectos.items.map((p) => {
          const primera = p.capturas[0];
          const n = p.capturas.length;
          return (
            <article class="caso" style={`--marca: ${p.color}`} data-revelar>
              <button
                class="caso__vista"
                type="button"
                data-abrir-galeria={p.id}
                aria-haspopup="dialog"
                aria-label={`${proyectos.etiquetaCapturas} ${p.nombre} (${n})`}
              >
                <span class="caso__barra">
                  <span class="puntos-ventana" aria-hidden="true">
                    <span />
                    <span />
                    <span />
                  </span>
                  <span class="caso__dominio">{p.enlace.etiqueta}</span>
                  <span class="caso__estado">
                    <span class="caso__punto-linea" aria-hidden="true" />
                    {proyectos.etiquetaEnLinea}
                  </span>
                </span>
                <Image
                  class="caso__miniatura"
                  src={primera.src}
                  alt={primera.titulo}
                  width={720}
                  widths={[360, 540, 720]}
                  sizes={tamanosTarjeta}
                  loading="lazy"
                />
                {n > 1 && (
                  <span class="caso__contador">
                    {n} {proyectos.unidadCapturas}
                  </span>
                )}
              </button>

              <div class="caso__cuerpo">
                <div class="caso__cabeza">
                  {p.logo && (
                    <span class="caso__logo" aria-hidden="true">
                      <Image src={p.logo} alt="" width={64} />
                    </span>
                  )}
                  <div class="caso__titulos">
                    <h3 class="caso__nombre">{p.nombre}</h3>
                    <p class="caso__tipo">{p.tipo}</p>
                  </div>
                </div>

                <p class="caso__rol">{p.rol}</p>
                <p class="caso__descripcion">{p.descripcion}</p>

                <details class="caso__detalle">
                  <summary class="caso__resumen">
                    {proyectos.etiquetaHice}
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                      <path d="M6 9l6 6 6-6" />
                    </svg>
                  </summary>
                  <ul class="lista-punto caso__lista">
                    {p.hice.map((h) => <li>{h}</li>)}
                  </ul>
                </details>

                <ul class="caso__herramientas" aria-label={proyectos.etiquetaHerramientas}>
                  {p.herramientas.map((h) => <li>{h}</li>)}
                </ul>

                <a class="boton boton--secundario boton--chico caso__enlace" href={p.enlace.url} target="_blank" rel="noopener" aria-label={`${p.enlace.label}: ${p.enlace.etiqueta}`}>
                  {p.enlace.label} <span aria-hidden="true">↗</span>
                </a>
              </div>

              <dialog class="galeria" data-galeria={p.id} aria-label={`${proyectos.etiquetaCapturas} ${p.nombre}`}>
                <div class="galeria__panel">
                  <header class="galeria__cabeza">
                    <p class="galeria__titulo">
                      {p.nombre}
                      {n > 1 && (
                        <span class="galeria__cuenta">
                          <span data-indice>1</span> / {n}
                        </span>
                      )}
                    </p>
                    <button class="galeria__cerrar" type="button" data-cerrar aria-label={proyectos.etiquetaCerrar}>
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <path d="M6 6l12 12M18 6L6 18" />
                      </svg>
                    </button>
                  </header>

                  <div class="galeria__escena">
                    {p.capturas.map((c, j) => (
                      <figure class="galeria__captura" data-captura hidden={j > 0}>
                        <Image src={c.src} alt={c.titulo} width={1600} widths={[960, 1280, 1600]} sizes={tamanosVentana} loading="lazy" />
                        <figcaption>{c.titulo}</figcaption>
                      </figure>
                    ))}
                    {n > 1 && (
                      <>
                        <button class="galeria__flecha galeria__flecha--antes" type="button" data-paso="-1" aria-label={proyectos.etiquetaAnterior}>
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                            <path d="M15 6l-6 6 6 6" />
                          </svg>
                        </button>
                        <button class="galeria__flecha galeria__flecha--despues" type="button" data-paso="1" aria-label={proyectos.etiquetaSiguiente}>
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                            <path d="M9 6l6 6-6 6" />
                          </svg>
                        </button>
                      </>
                    )}
                  </div>

                  {n > 1 && (
                    <div class="galeria__miniaturas">
                      {p.capturas.map((c, j) => (
                        <button
                          class="galeria__miniatura"
                          type="button"
                          data-ir={j}
                          aria-pressed={j === 0 ? 'true' : 'false'}
                          aria-label={`${proyectos.etiquetaCaptura}: ${c.titulo}`}
                        >
                          <Image src={c.src} alt="" width={200} loading="lazy" />
                        </button>
                      ))}
                    </div>
                  )}
                </div>
              </dialog>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  // Una ventana por proyecto. Se abre desde la imagen de la tarjeta; se recorre
  // con las flechas, las miniaturas o el teclado (← →), y se cierra con la X,
  // Escape o un clic en el fondo.
  document.querySelectorAll<HTMLButtonElement>('[data-abrir-galeria]').forEach((abrir) => {
    const dialogo = document.querySelector<HTMLDialogElement>(`[data-galeria="${abrir.dataset.abrirGaleria}"]`);
    if (!dialogo) return;

    const capturas = dialogo.querySelectorAll<HTMLElement>('[data-captura]');
    const miniaturas = dialogo.querySelectorAll<HTMLButtonElement>('[data-ir]');
    const indice = dialogo.querySelector<HTMLElement>('[data-indice]');
    let actual = 0;

    const mostrar = (i: number) => {
      actual = (i + capturas.length) % capturas.length;
      capturas.forEach((c, k) => (c.hidden = k !== actual));
      miniaturas.forEach((m, k) => m.setAttribute('aria-pressed', String(k === actual)));
      if (indice) indice.textContent = String(actual + 1);
    };

    abrir.addEventListener('click', () => {
      mostrar(0);
      dialogo.showModal();
    });
    dialogo.querySelector('[data-cerrar]')?.addEventListener('click', () => dialogo.close());
    dialogo.querySelectorAll<HTMLButtonElement>('[data-paso]').forEach((b) =>
      b.addEventListener('click', () => mostrar(actual + Number(b.dataset.paso))),
    );
    miniaturas.forEach((m) => m.addEventListener('click', () => mostrar(Number(m.dataset.ir))));
    dialogo.addEventListener('keydown', (e) => {
      if (capturas.length < 2) return;
      if (e.key === 'ArrowRight') mostrar(actual + 1);
      if (e.key === 'ArrowLeft') mostrar(actual - 1);
    });

    // Clic en el fondo: solo si el clic también empezó afuera (igual que el
    // formulario de contacto).
    let presionFuera = false;
    dialogo.addEventListener('pointerdown', (e) => (presionFuera = e.target === dialogo));
    dialogo.addEventListener('click', (e) => {
      if (presionFuera && e.target === dialogo) dialogo.close();
      presionFuera = false;
    });
  });
</script>

<style>
  /* Sin banda (Experiencia y Herramientas, a los lados, sí la llevan): acá
     el ritmo lo dan las luces de los colores de marca de los proyectos,
     detrás de las tarjetas. */
  #proyectos {
    position: relative;
    isolation: isolate;
  }

  #proyectos::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(30% 35% at 15% 70%, color-mix(in srgb, #2b8a74 12%, transparent), transparent 70%),
      radial-gradient(30% 35% at 50% 80%, color-mix(in srgb, #cd6340 10%, transparent), transparent 70%),
      radial-gradient(30% 35% at 88% 65%, color-mix(in srgb, #1d9e75 10%, transparent), transparent 70%);
  }

  .proyectos {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .proyectos__encabezado {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .proyectos__bajada {
    max-width: 40rem;
    font-size: var(--size-md);
    line-height: 1.62;
    color: var(--text-body);
  }

  .proyectos__grilla {
    display: grid;
    gap: 1.25rem;
    align-items: stretch;
  }

  @media (min-width: 720px) {
    .proyectos__grilla {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1080px) {
    .proyectos__grilla {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* ---- Tarjeta ------------------------------------------------------------ */

  .caso {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background:
      radial-gradient(90% 50% at 0% 0%, color-mix(in srgb, var(--marca) 14%, transparent), transparent 70%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.02)),
      var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  /* Línea de color arriba, como las tarjetas de Herramientas. */
  .caso::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1;
    height: 2px;
    background: linear-gradient(to right, var(--marca), transparent 85%);
  }

  .caso__vista {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    cursor: zoom-in;
  }

  :global(html:not(.js)) .caso__vista {
    cursor: default;
  }

  .caso__miniatura {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top left;
    transition: transform 0.3s ease;
  }

  .caso__vista:hover .caso__miniatura {
    transform: scale(1.02);
  }

  /* Barra de ventana sobre la captura. */
  .caso__barra {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .caso__dominio {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: var(--size-xs);
    color: var(--text-soft);
  }

  .caso__estado {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.375rem;
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--size-xs);
    color: var(--en-linea);
  }

  .caso__punto-linea {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--en-linea);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--en-linea) 20%, transparent);
  }

  .caso__contador {
    position: absolute;
    bottom: 0.625rem;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-pill);
    background: rgb(var(--bg-rgb) / 0.8);
    backdrop-filter: blur(6px);
    font-family: var(--font-mono);
    font-size: var(--size-xs);
    color: var(--text);
    right: 0.625rem;
  }

  :global(html:not(.js)) .caso__contador {
    display: none;
  }

  .caso__cuerpo {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.125rem 1.25rem 1.25rem;
  }

  .caso__cabeza {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .caso__logo {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    overflow: hidden;
    border-radius: var(--radius);
    background: #fff;
  }

  .caso__logo :global(img) {
    width: 72%;
    height: 72%;
    object-fit: contain;
  }

  .caso__titulos {
    min-width: 0;
  }

  .caso__nombre {
    font-size: var(--size-lg);
    font-weight: var(--weight-bold);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .caso__tipo {
    font-family: var(--font-mono);
    font-size: var(--size-xs);
    letter-spacing: 0.04em;
    color: var(--text-soft);
  }

  .caso__rol {
    align-self: flex-start;
    padding: 0.125rem 0.5rem;
    border: 1px solid color-mix(in srgb, var(--marca) 45%, transparent);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--marca) 14%, transparent);
    font-size: var(--size-xs);
    color: var(--text);
  }

  .caso__descripcion {
    font-size: var(--size-sm);
    line-height: 1.6;
    color: var(--text-body);
  }

  /* «Lo que hice», plegado: el resumen es un botón chico, no un texto
     subrayado. */
  .caso__resumen {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.04);
    font-size: var(--size-xs);
    font-weight: 500;
    color: var(--text);
    cursor: pointer;
    list-style: none;
  }

  .caso__resumen::-webkit-details-marker {
    display: none;
  }

  .caso__resumen:hover {
    border-color: var(--text-soft);
  }

  .caso__resumen svg {
    transition: transform 0.2s ease;
  }

  .caso__detalle[open] .caso__resumen svg {
    transform: rotate(180deg);
  }

  .caso__lista {
    margin-top: 0.75rem;
  }

  .caso__lista > li {
    font-size: var(--size-sm);
  }

  .caso__lista > li::before {
    background: var(--marca);
  }

  .caso__herramientas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .caso__herramientas li {
    padding: 0.1875rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.03);
    font-size: var(--size-xs);
    color: var(--text-body);
  }

  /* El enlace al fondo: las tres tarjetas lo alinean aunque el texto mida
     distinto. */
  .caso__enlace {
    align-self: flex-start;
    margin-top: auto;
  }

  /* ---- Ventana de capturas ------------------------------------------------ */

  :global(html:has(.galeria[open])) {
    overflow: hidden;
    scrollbar-gutter: stable;
  }

  .galeria {
    width: min(100% - 1rem, 68rem);
    max-width: none;
    max-height: calc(100dvh - 1rem);
    margin: auto;
    padding: 0;
    overflow: hidden;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    color: var(--text);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.5);
  }

  .galeria::backdrop {
    background: rgb(var(--bg-rgb) / 0.85);
    backdrop-filter: blur(4px);
  }

  .galeria__panel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-height: inherit;
    padding: 0.75rem;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .galeria__cabeza {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-left: 0.25rem;
  }

  .galeria__titulo {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-weight: var(--weight-bold);
  }

  .galeria__cuenta {
    font-family: var(--font-mono);
    font-size: var(--size-xs);
    font-weight: 400;
    color: var(--text-soft);
  }

  .galeria__cerrar,
  .galeria__flecha {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    background: rgb(var(--bg-rgb) / 0.75);
    color: var(--text);
    cursor: pointer;
  }

  .galeria__cerrar:hover,
  .galeria__flecha:hover {
    border-color: var(--text-soft);
  }

  .galeria__escena {
    position: relative;
  }

  .galeria__captura {
    margin: 0;
  }

  .galeria__captura[hidden] {
    display: none;
  }

  .galeria__captura :global(img) {
    display: block;
    width: 100%;
    height: auto;
    max-height: calc(100dvh - 15rem);
    object-fit: contain;
    border-radius: var(--radius);
    background: var(--surface);
  }

  .galeria__captura figcaption {
    padding: 0.625rem 0.25rem 0;
    font-size: var(--size-sm);
    color: var(--text-soft);
  }

  .galeria__flecha {
    position: absolute;
    top: calc(50% - 1.75rem);
  }

  .galeria__flecha--antes {
    left: 0.5rem;
  }

  .galeria__flecha--despues {
    right: 0.5rem;
  }

  /* En teléfono la captura es chica y las flechas encima la tapan: van en una
     fila debajo, a la derecha. */
  @media (max-width: 719px) {
    .galeria__escena {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto auto;
      gap: 0.5rem;
    }

    .galeria__captura {
      grid-column: 1 / -1;
    }

    .galeria__flecha {
      position: static;
    }

    .galeria__flecha--antes {
      grid-column: 2;
    }

    .galeria__flecha--despues {
      grid-column: 3;
    }
  }

  .galeria__miniaturas {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
  }

  .galeria__miniatura {
    flex: 0 0 6rem;
    height: 3.75rem;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    cursor: pointer;
    opacity: 0.6;
  }

  .galeria__miniatura:hover {
    opacity: 0.9;
  }

  .galeria__miniatura[aria-pressed='true'] {
    opacity: 1;
    border-color: var(--marca);
    box-shadow: 0 0 0 1px var(--marca);
  }

  .galeria__miniatura :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
</style>
