---
import { preguntas } from '../data/contenido';

// Sin JavaScript: <details> nativo. Desde 900px, el encabezado a la
// izquierda y la lista a la derecha (antes la lista ocupaba solo la mitad
// izquierda y la derecha quedaba vacía).
---

<section class="seccion seccion--banda" id="preguntas">
  <div class="contenedor preguntas">
    <div class="preguntas__encabezado">
      <p class="rotulo rotulo--seccion">{preguntas.rotulo}</p>
      <h2 class="titulo-seccion">{preguntas.titulo}</h2>
    </div>

    <div class="preguntas__lista">
      {
        preguntas.items.map((item) => (
          <details class="pregunta" data-revelar>
            <summary class="pregunta__titulo">{item.pregunta}</summary>
            <p class="pregunta__respuesta">{item.respuesta}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .preguntas {
    display: grid;
    gap: 1.75rem;
    align-items: start;
  }

  .preguntas__encabezado {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .preguntas__lista {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  @media (min-width: 900px) {
    .preguntas {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      column-gap: 3.5rem;
    }
  }

  .pregunta {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .pregunta[open] {
    border-color: var(--border-strong);
  }

  .pregunta__titulo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--tap);
    padding: 1rem 1.25rem;
    cursor: pointer;
    list-style: none;
    font-size: var(--size-md);
    font-weight: var(--weight-medium);
    line-height: 1.35;
    color: var(--text);
    border-radius: var(--radius);
  }

  .pregunta__titulo::-webkit-details-marker {
    display: none;
  }

  .pregunta__titulo::after {
    content: '+';
    flex-shrink: 0;
    font-size: 1.5rem;
    font-weight: var(--weight-light);
    line-height: 1;
    color: var(--accent);
  }

  .pregunta[open] > .pregunta__titulo::after {
    content: '–';
  }

  .pregunta__titulo:hover {
    background: rgba(255, 255, 255, 0.03);
  }

  .pregunta__respuesta {
    padding: 0 1.25rem 1.25rem;
    font-size: var(--size-base);
    line-height: 1.62;
    color: var(--text-body);
  }

  @media (min-width: 768px) {
    .pregunta__titulo {
      padding: 1.125rem 1.5rem;
    }

    .pregunta__respuesta {
      padding: 0 1.5rem 1.5rem;
    }
  }
</style>
