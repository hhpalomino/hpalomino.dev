---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { contacto, trabajos } from '../data/site';
import { hero, trabajoPublicado } from '../data/contenido';
import IconoWhatsApp from './IconoWhatsApp.astro';
import trasciende from '../assets/trabajos/trasciende.png';
import mateos from '../assets/trabajos/mateos.jpg';
import bistream from '../assets/trabajos/bistream.png';

// Franja corta de sitios en vivo (PRODUCT.md). El detalle completo —más
// capturas, trayectoria, tecnologías— vive en /portafolio.

// Captura de cada trabajo, por nombre (el mismo de site.ts). Un trabajo sin
// captura en esta lista se muestra sin marco, solo con sus textos.
type NombreTrabajo = (typeof trabajos)[number]['nombre'];
const capturas: Partial<Record<NombreTrabajo, ImageMetadata>> = {
  'Trasciende Legal': trasciende,
  "Mateo's Coffee": mateos,
  Bistream: bistream,
};

// La captura repite el enlace de "visitar": va con tabindex="-1" para que
// quien navega con teclado no pase dos veces por el mismo destino.
// width={1200} fija el src de respaldo en el mayor de los anchos, en vez de
// la captura original (hasta 3456 px).

// Ancho real de cada captura: columna completa en teléfono, un tercio de la
// columna de texto desde 768 px (1080 px de texto en el contenedor máximo).
const tamanos = '(min-width: 1200px) 347px, (min-width: 768px) calc((100vw - 160px) / 3), calc(100vw - 40px)';
---

<section class="seccion seccion--trabajo" id="trabajo">
  <div class="contenedor trabajo">
    <p class="rotulo rotulo--seccion">{trabajoPublicado.rotulo}</p>

    <h2 class="titulo-seccion">
      {trabajoPublicado.titulo.antes}<span class="enfasis">{trabajoPublicado.titulo.enfasis}</span>{trabajoPublicado.titulo.despues}
    </h2>

    <p class="trabajo__intro">{trabajoPublicado.intro}</p>

    <div class="trabajo__grilla">
      {
        trabajos.map((t) => {
          const captura = capturas[t.nombre];
          return (
            <article class="caso" data-revelar>
              {captura ? (
                <a class="caso__marco" href={t.url} target="_blank" rel="noopener" tabindex="-1">
                  <span class="caso__barra">
                    <span class="puntos-ventana" aria-hidden="true">
                      <span></span>
                      <span></span>
                      <span></span>
                    </span>
                    <span class="caso__tipo">
                      {t.tipo} · {t.lugar}
                    </span>
                  </span>
                  <span class="caso__captura">
                    <span class="caso__estado">
                      <span class="caso__punto" aria-hidden="true"></span>
                      {trabajoPublicado.enLinea}
                    </span>
                    <Image
                      class="caso__imagen"
                      src={captura}
                      alt={`${trabajoPublicado.altCaptura} ${t.nombre}`}
                      width={1200}
                      widths={[480, 800, 1200]}
                      sizes={tamanos}
                      loading="lazy"
                    />
                  </span>
                </a>
              ) : (
                <p class="caso__meta">
                  {t.tipo} · {t.lugar}
                </p>
              )}

              <div class="caso__cuerpo">
                <h3 class="caso__nombre">{t.nombre}</h3>
                <p class="caso__texto">{trabajoPublicado.descripciones[t.nombre]}</p>
                <a
                  class="boton boton--secundario boton--chico caso__enlace"
                  href={t.url}
                  target="_blank"
                  rel="noopener"
                  aria-label={`${trabajoPublicado.ver[t.nombre]}: ${t.etiqueta}`}
                >
                  {trabajoPublicado.ver[t.nombre]}
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            </article>
          );
        })
      }
    </div>

    <!-- Cierre: el "quiero algo así" de titacode y yurilopes.site. -->
    <div class="trabajo__cierre">
      <p class="trabajo__cierre-texto">{trabajoPublicado.cierre}</p>
      <div class="trabajo__botones">
        <a class="boton" href={contacto.whatsappCL.url}>
          <IconoWhatsApp color="var(--accent-ink)" />
          {hero.botonWhatsApp}
        </a>
        <a class="boton boton--secundario" href={trabajoPublicado.enlace.href}>
          {trabajoPublicado.enlace.label} <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .seccion--trabajo {
    background-image: radial-gradient(50% 45% at 50% 70%, color-mix(in srgb, var(--tono-violeta) 6%, transparent), transparent 70%);
  }

  .trabajo {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .trabajo__intro {
    max-width: 40rem;
    font-size: var(--size-md);
    line-height: 1.62;
    color: var(--text-body);
  }

  /* minmax(0, 1fr): sin esto, el rótulo del marco (una línea sin cortes)
     ensancha la columna más allá de la pantalla en teléfono. */
  .trabajo__grilla {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    margin-block: 1rem 0.5rem;
  }

  /* El cuadro ya no lleva fondo propio: lo que destaca es la ventana con la
     captura, y los textos van debajo, sueltos. */
  .caso {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Marco de ventana de navegador. Es un enlace (el mismo de "visitar"),
     por eso es lo único del cuadro que reacciona al mouse. */
  .caso__marco {
    display: block;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .caso__barra {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 2.25rem;
    padding-inline: 0.875rem;
    border-bottom: 1px solid var(--border);
  }

  .caso__tipo {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: var(--size-xs);
    color: var(--text-soft);
  }

  .caso__captura {
    position: relative;
    display: block;
    overflow: hidden;
  }

  .caso__imagen {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    transition: transform 0.4s ease;
  }

  .caso__marco:hover .caso__imagen {
    transform: scale(1.03);
  }

  /* Solo si un trabajo no tiene captura: el tipo y el lugar van en texto. */
  .caso__meta {
    font-size: var(--size-sm);
    line-height: 1.4;
    color: var(--text-soft);
  }

  .caso__cuerpo {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.5rem;
  }

  .caso__nombre {
    font-size: 1.375rem;
    font-weight: var(--weight-bold);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .caso__texto {
    font-size: var(--size-base);
    line-height: 1.6;
    color: var(--text-body);
  }

  .caso__enlace {
    align-self: flex-start;
    margin-top: auto;
    overflow-wrap: anywhere;
  }

  /* Etiqueta de estado sobre la captura, en la esquina: punto verde y "En
     línea". Va sobre la imagen y no en la barra, para no cortar el tipo de
     negocio. Fondo oscuro translúcido para que se lea sobre cualquier
     captura, clara u oscura. */
  .caso__estado {
    position: absolute;
    top: 0.625rem;
    right: 0.625rem;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.5rem;
    border: 1px solid color-mix(in srgb, var(--en-linea) 35%, transparent);
    border-radius: var(--radius-pill);
    background: rgb(var(--bg-rgb) / 0.8);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    font-family: var(--font-mono);
    font-size: var(--size-xs);
    color: var(--en-linea);
    white-space: nowrap;
  }

  .caso__punto {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--en-linea);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--en-linea) 25%, transparent);
  }

  .trabajo__cierre {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .trabajo__cierre-texto {
    font-size: var(--size-xl);
    font-weight: var(--weight-light);
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .trabajo__botones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .trabajo__botones .boton {
    width: 100%;
  }

  @media (min-width: 768px) {
    .trabajo__cierre {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
    }

    .trabajo__botones .boton {
      width: auto;
    }
  }

  @media (min-width: 768px) {
    .trabajo__grilla {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .caso__marco:hover .caso__imagen {
      transform: none;
    }
  }
</style>
