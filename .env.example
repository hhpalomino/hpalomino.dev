# Variables del formulario de contacto. Paso a paso: docs/formulario.md.
# Copia este archivo como .env y pega ahí los valores; .env no se sube al
# repositorio. En producción van en Vercel → Settings → Environment Variables.
# Sin valores, el formulario igual se prueba en desarrollo: usa las claves de
# prueba de Turnstile y muestra el correo en la consola en vez de enviarlo.

# Cloudflare → Turnstile → tu widget → "Site Key". Es pública: queda en el HTML.
PUBLIC_TURNSTILE_SITE_KEY=
# Cloudflare → Turnstile → el mismo widget → "Secret Key". Secreta.
TURNSTILE_SECRET_KEY=
# Resend → API Keys → una clave con permiso "Sending access". Secreta.
RESEND_API_KEY=
